<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_home_to_editor"
            app:destination="@id/editorFragment" />
        <action
            android:id="@+id/action_home_to_vault"
            app:destination="@id/vaultFragment" />
        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/vaultFragment"
        android:name="com.example.ui.vault.VaultFragment"
        android:label="@string/nav_vault">
        <action
            android:id="@+id/action_vault_to_editor"
            app:destination="@id/editorFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.ui.search.SearchFragment"
        android:label="@string/nav_search">
        <action
            android:id="@+id/action_search_to_editor"
            app:destination="@id/editorFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.ui.explore.ExploreFragment"
        android:label="@string/nav_explore">
        <action
            android:id="@+id/action_explore_to_vault"
            app:destination="@id/vaultFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.example.ui.editor.EditorFragment"
        android:label="Editor">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>
</navigation>
